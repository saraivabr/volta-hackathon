# Application
APP_BASE_URL=http://localhost:3000
DEMO_ACCESS_CODE=change-me
SESSION_SECRET=change-me
CRON_SECRET=change-me
OPERATOR_PHONE_E164=+15555550100

# OpenAI
OPENAI_API_KEY=
OPENAI_PROJECT_ID=proj_replace_me
OPENAI_WEBHOOK_SECRET=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOLTA_MCP_SECRET=change-me
RELAY_SHARED_SECRET=change-me
REALTIME_RELAY_URL=wss://volta-realtime-relay.example.workers.dev/twilio/

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telnyx (PSTN via TeXML + OpenAI SIP). TELNYX_TEXML_ACCOUNT_SID is the
# organization_id returned by GET /v2/public_key. TELNYX_PUBLIC_KEY comes from
# the same response and verifies the Ed25519 webhook signature.
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_TEXML_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=
TELNYX_PUBLIC_KEY=
TELNYX_SIP_DOMAIN=

# SIP is the full conference path. media-stream is compatible with Twilio Trial.
VOLTA_REALTIME_TRANSPORT=media-stream
# twilio | whatsapp | telnyx
VOLTA_VOICE_TRANSPORT=telnyx

# WaCalls WhatsApp voice bridge
WACALLS_BASE_URL=https://volta-wacalls.example.com
WACALLS_API_TOKEN=change-me
WACALLS_ALLOWED_PHONES=+15555550100
WACALLS_WEBRTC_PUBLIC_IP=203.0.113.10

# Written recap by email. The recap goes out over every configured channel; a
# phone and a mailbox fail in different ways and either record is enough.
RESEND_API_KEY=
RECAP_FROM_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force local seeded repository even when Supabase is configured
VOLTA_DEMO_MODE=false
